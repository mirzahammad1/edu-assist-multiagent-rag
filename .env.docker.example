# ============================================================
# EDU Assist — Docker Environment Variables
# ============================================================
# Copy this file to .env to initialize configuration:
#   cp .env.docker.example .env
# ============================================================

# HuggingFace Token (Required for gated models like Llama 3.2)
HUGGINGFACE_TOKEN=your_hugging_face_token_here

# --- MongoDB (Inside Docker, resolves to the database container) ---
MONGO_URI=mongodb://mongodb:27017
DB_NAME=FAQ_AGENT
FAQ_COLLECTION=FAQs

# --- Paths (relative to the container workdir /app) ---
DOCUMENT_FOLDER=data/documents
VECTOR_DB_FOLDER=data/vectorstore
URLS_FILE=config/urls.txt
BASE_DOMAIN=kiet.edu.pk

# --- LLM Model Settings ---
LLM_MODEL=meta-llama/Llama-3.2-1B-Instruct
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.0

# --- Pipeline Settings ---
BUILD_INDEX_ON_START=1
FORCE_REINDEX=0
LOG_LEVEL=INFO
DEBUG_MODE=0

# --- Security ---
# Change the API key to a strong random hex string for production
ADMIN_API_KEY=8f4b23d9a1e7c560b492618d3f82a19e
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234
ADMIN_SESSION_TTL=28800

# --- Web Server ---
# CORS_ORIGINS=*
